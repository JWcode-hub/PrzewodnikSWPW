@* Podsumowanie błędów formularza z linkami do pól (WCAG 3.3.1). Fokus trafia na pierwsze błędne pole
   przez autofocus z PoleTagHelper; role="alert" ogłasza podsumowanie czytnikom ekranu. *@
@if (!ViewData.ModelState.IsValid)
{
    var bledy = ViewData.ModelState
        .Where(p => p.Value is { Errors.Count: > 0 })
        .SelectMany(p => p.Value!.Errors.Select(b => (Pole: p.Key, b.ErrorMessage)))
        .ToList();
    <div class="komunikat komunikat--blad" role="alert">
        <h2 class="h5">@(bledy.Count == 1 ? "Popraw 1 błąd w formularzu" : $"Popraw błędy w formularzu ({bledy.Count})")</h2>
        <ul>
            @foreach (var (pole, komunikat) in bledy)
            {
                if (string.IsNullOrEmpty(pole))
                {
                    <li>@komunikat</li>
                }
                else
                {
                    <li><a href="#@TagBuilder.CreateSanitizedId(pole, "_")">@komunikat</a></li>
                }
            }
        </ul>
    </div>
}
